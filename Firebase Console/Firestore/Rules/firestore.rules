rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ Helpers ============
    function isAdmin() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isApproved() {
      return request.auth != null 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // ============ ACADEMY v2 ============
    
    // المستخدمين
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin() || isOwner(uid);
      allow delete: if isAdmin();
    }

    // طلبات الانضمام (تحتاج موافقة الأدمن)
    match /user_requests/{docId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // أكواد الدعوة
    match /invite_codes/{code} {
      allow read: if true; // للتحقق أثناء التسجيل
      allow write: if isAdmin();
    }

    // الاشتراكات (الشق المدفوع)
    match /subscriptions/{docId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // المحاور والدروس (القراءة للطلاب الموافق عليهم فقط)
    match /modules/{docId} {
      allow read: if true; 
      allow write: if isAdmin();
    }
    match /lessons/{docId} {
      allow read: if isApproved() || isAdmin(); 
      allow write: if isAdmin();
    }

    // حماية المحتوى
    match /content_protection/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
    }

    // تقدم الطالب
    match /user_progress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /quizzes/{docId} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }
    match /quiz_attempts/{docId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /strategies/{docId} {
      allow read, write: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /campaigns/{docId} {
      allow read, write: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /campaign_daily/{docId} {
      allow read, write: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /certificates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /events_log/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }

    // ============ الموقع العام والأدمن ============
    match /admins/{docId} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == docId);
    }
    match /analytics/main {
      allow read: if true;
      allow write: if true;
    }
    match /portfolio/{docId} { allow read, write: if true; }
    match /blog/{docId} { allow read, write: if true; }
    match /blog_drafts/{docId} { allow read, write: if true; }
    match /blog_revisions/{docId} { allow read, write: if true; }
    match /media_library/{docId} { allow read, write: if true; }
    match /newsletter_subscribers/{docId} { allow read, write: if true; }
    match /comments/{docId} { allow read, write: if true; }
    match /event_logs/{docId} { allow read, write: if true; }
    match /system/{docId} { allow read, write: if true; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
