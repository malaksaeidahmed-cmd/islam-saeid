rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ Helpers ============
    function isAdmin() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ============ NEW: Academy Collections ============
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /user_progress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /courses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lessons/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizzes/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /quiz_attempts/{docId} {
      allow read: if request.auth != null && 
        (isOwner(resource.data.uid) || isAdmin());
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAdmin();
    }

    match /strategies/{docId} {
      allow read: if request.auth != null && 
        (isOwner(resource.data.uid) || isAdmin());
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && 
        (isOwner(resource.data.uid) || isAdmin());
    }

    match /campaigns/{docId} {
      allow read: if request.auth != null && 
        (isOwner(resource.data.uid) || isAdmin());
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && 
        (isOwner(resource.data.uid) || isAdmin());
    }

    match /campaign_daily/{docId} {
      allow read: if request.auth != null && 
        (isOwner(resource.data.uid) || isAdmin());
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAdmin();
    }

    match /certificates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /challenges/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /challenge_submissions/{docId} {
      allow read: if true;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAdmin();
    }

    match /leaderboard/{period} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /badges/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events_log/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ============ EXISTING Collections ============
    match /admins/{docId} {
      allow read: if true;
      allow write: if isAdmin() || 
        (request.auth != null && request.auth.uid == docId);
    }

    match /analytics/main {
      allow read: if true;
      allow write: if true;
    }

    match /portfolio/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /blog/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /blog_drafts/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /blog_revisions/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /media_library/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /newsletter_subscribers/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /comments/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /event_logs/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
