rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ===== USERS =====
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===== INVITE TOKENS =====
    match /invite_tokens/{token} {
      // public read to validate token
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== UNITS =====
    match /units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ===== LESSONS =====
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ===== PRACTICAL EXAMS =====
    match /practical_exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ===== UNIT EXAMS =====
    match /unit_exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ===== STUDENT PROGRESS =====
    match /student_progress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===== STUDENT ACTIVITY =====
    match /student_activity/{activityId} {
      allow read: if isAdmin() || 
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn();
    }

    // ===== CERTIFICATES =====
    match /certificates/{certId} {
      allow read: if isSignedIn() && 
        (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ===== ADMIN LOGS =====
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ===== CAMPAIGNS =====
    match /campaigns/{campaignId} {
      allow read: if isSignedIn() && 
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && 
        resource.data.uid == request.auth.uid;
    }

    // ===== ADMIN CAN DO ANYTHING =====
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
